# =========================================================
# LOCAL DEVELOPMENT - SQLite
# =========================================================
# Copy this to .env.local for local development

DB_TYPE=sqlite
SQLITE_PATH=munder_difflin.db
OPENAI_API_KEY=your-key-here

# =========================================================
# AWS PRODUCTION - PostgreSQL on RDS
# =========================================================
# Set these environment variables in your AWS deployment

# Option 1: Using individual components
# DB_TYPE=postgres
# DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=admin
# DB_PASSWORD=your-secure-password
# DB_NAME=paper_supplies
# OPENAI_API_KEY=your-key-here
# PORT=8000

# Option 2: Using DATABASE_URL (recommended for cloud platforms)
# DATABASE_URL=postgresql://user:password@host:5432/database
# OPENAI_API_KEY=your-key-here
# PORT=8000

# =========================================================
# ECS FARGATE ENVIRONMENT VARIABLES
# =========================================================
# Define these in your ECS Task Definition:
# 
# DATABASE_URL: postgresql://user:password@rds-endpoint:5432/db
# OPENAI_API_KEY: (secret from Secrets Manager or Parameter Store)
# PORT: 8000
# AWS_REGION: us-east-1

# =========================================================
# Cloud Run (Google Cloud) - Not AWS but reference
# =========================================================
# gcloud run deploy paper-supply-api \
#   --image gcr.io/your-project/paper-supply-api:latest \
#   --set-env-vars DATABASE_URL=postgresql://...,OPENAI_API_KEY=...
